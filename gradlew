#!/bin/sh
#
# 编译闸门（硬拦截）：没有 .aharou/build-allowed 就拒绝执行任何 Gradle 任务。
# 为什么要有它：AI 多次未获授权就起构建，规则和记忆都拦不住，只能在这里拦。
# 授权方式：用户明确说「编译」后创建该文件；构建结束立即删除。
# CI 例外：.github/workflows 里的构建步骤会先创建该文件。
#
_repo_dir=$(cd "$(dirname "$0")" && pwd)
_gate="$_repo_dir/.aharou/build-allowed"
_deny() {
  cat >&2 <<'MSG'
[拒绝] 编译未获授权。

授权文件 .aharou/build-allowed 必须写明来源，空文件无效：
  authorized_by: 主人
  quote: "编吧"
  at: 2026-10-22T10:40

得到主人明确同意后写入上述内容，构建结束后删除该文件。
MSG
  exit 1
}
# CI 放行：workflow 在 job 级声明 AHAROU_CI_BUILD=1。CI 只在 push/tag 时跑、不经过 AI 会话，
# 而授权文件是一次性消费的：一个 job 里 smoke + 单测两次调 gradlew，第二次会被误拒。
if [ "${AHAROU_CI_BUILD:-0}" != "1" ]; then
  [ -f "$_gate" ] || _deny
  grep -q 'authorized_by:' "$_gate" || _deny
  grep -q 'at:' "$_gate" || _deny
  # 时效校验：授权只在这一轮有效。留着一枚旧令牌（或忘了删文件）也没法在半小时后再用。
  _at=$(sed -n 's/^at: *//p' "$_gate" | head -1)
  _at_s=$(date -d "$_at" +%s 2>/dev/null || echo 0)
  _now=$(date +%s)
  if [ "$_at_s" -gt 0 ] && [ $((_now - _at_s)) -gt 1800 ]; then
    echo "[拒绝] 该授权已超过 30 分钟（at: $_at），请重新取得主人确认。" >&2
    exit 1
  fi
  # 审计留痕：谁批的、什么授权原话、跑了什么任务。伪造授权会在这里留下无出处的记录。
  { echo "[$(date '+%Y-%m-%d %H:%M:%S')] task=$* | $(tr '\n' ' ' < "$_gate")"; } >> "$_repo_dir/.aharou/build-audit.log" 2>/dev/null
  # 一次性令牌：消费后立即删除。旧授权留着不删，同一枚「可以」就会被之后几次构建反复借用，
  # 闸门也就形同虚设（2026-10-24 实测：18:13 的授权被用到 22:52）。
  rm -f "$_gate"
fi

#
