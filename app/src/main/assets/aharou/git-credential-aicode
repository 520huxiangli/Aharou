#!/bin/sh
# 自定义 git credential helper：本地 / 远程统一的凭据入口。
#
# 凭据真源 ~/.aicode/git-credentials，内容为「store 明文 base64 后整体反转」的编码串——
# 文件不是可直接回显的明文，可挡住随手 cat、grep 扫描与 AI 读取进上下文。属混淆而非加密：
# 主动读本脚本即可还原，定位是提高门槛而非防住刻意攻击。
#
# 本 helper 负责解码后按 host 命中并输出 KV；未命中时：
#   本地 → 写 cred-req-<id> 经文件 IPC 请 App 弹窗回填 → 轮询 cred-resp-<id>；
#   远程（AICODE_CRED_NO_PROMPT 非空，服务器上没有 App）→ 直接空退出。
#
# 经 PRoot -b 绑定：容器内 /root/.aicode ⇔ 宿主 filesDir/aicode 同一 inode，
# 故 app 侧 FileObserver 监听 filesDir/aicode 的 cred-req-* 创建事件即可触发弹窗。
# 仅 HTTPS 生效：git 只对 http/https remote 调 credential helper 的 get，SSH 走 ssh-agent 不触发。
#
# shebang 用 /bin/sh：PRoot Alpine 自带 busybox ash 永在，provisioning 失败时也得能跑（不依赖 bash）。

op="$1"
# 只处理 get；store/erase 空退出（凭据落盘由 app 侧 FileCredentialRepository 负责）。
[ "$op" = "get" ] || exit 0

# 读 stdin 全部 KV，拿 host（git credential 协议字段已小写归一）。
host=""
while IFS= read -r line; do
  case "$line" in
    host=*) host="${line#host=}" ;;
  esac
done
[ -n "$host" ] || exit 0

AICODE="${AICODE_DIR:-$HOME/.aicode}"
CREDS="$AICODE/git-credentials"

# URL 解码：%XX → 字节（纯 awk，兼容 busybox awk，不依赖额外工具）。
urldecode() {
  printf '%s' "$1" | awk '
  {
    out = ""
    for (i = 1; i <= length($0); i++) {
      c = substr($0, i, 1)
      if (c == "%" && i + 2 <= length($0)) {
        h = substr($0, i + 1, 2)
        d1 = index("0123456789abcdef", tolower(substr(h, 1, 1))) - 1
        d2 = index("0123456789abcdef", tolower(substr(h, 2, 1))) - 1
        if (d1 >= 0 && d2 >= 0) { out = out sprintf("%c", d1 * 16 + d2); i += 2; continue }
      }
      out = out c
    }
    printf "%s", out
  }'
}

# 解码凭据文件：整体反转后 base64 解码；base64 命令缺失时逐级 fallback。
decode_creds() {
  [ -f "$CREDS" ] || return 0
  raw="$(cat "$CREDS" 2>/dev/null)"
  [ -n "$raw" ] || return 0
  rev="$(printf '%s' "$raw" | awk '{ for (i = length($0); i > 0; i--) printf "%s", substr($0, i, 1) }')"
  printf '%s' "$rev" | base64 -d 2>/dev/null && return 0
  printf '%s' "$rev" | openssl base64 -d -A 2>/dev/null && return 0
  printf '%s' "$rev" | python3 -c 'import base64,sys;sys.stdout.buffer.write(base64.b64decode(sys.stdin.read()))' 2>/dev/null && return 0
  return 1
}

content="$(decode_creds)"
if [ -n "$content" ]; then
  # @host 行尾精确匹配，避免 gist.github.com 误命中 github.com（用 awk 而非 grep 以防 host 含正则元字符）。
  line="$(printf '%s\n' "$content" | awk -v h="$host" 'substr($0, length($0) - length(h)) == "@" h { print; exit }')"
  if [ -n "$line" ]; then
    ut="${line#*://}"
    ut="${ut%@*}"
    printf 'username=%s\npassword=%s\n' "$(urldecode "${ut%%:*}")" "$(urldecode "${ut#*:}")"
    exit 0
  fi
fi

# 未命中：远程无 App 可弹窗，直接空退出（git 自然报认证失败）。
[ -n "$AICODE_CRED_NO_PROMPT" ] && exit 0

# 未命中（本地）→ 写请求文件（原子写：先 .tmp 再 mv，触发 inotify 且避免 app 读半截），阻塞轮询响应。
RID="$(date +%s)-$$"
REQ="$AICODE/cred-req-$RID"
RESP="$AICODE/cred-resp-$RID"
printf 'host=%s\n' "$host" > "$REQ.tmp"
mv "$REQ.tmp" "$REQ"

# 轮询响应（200ms）。绝对上限 ~25min（配合 watchdog 的 30min 兜底），超时放弃，删请求退出非零。
i=0
while [ ! -f "$RESP" ]; do
  sleep 0.2
  i=$((i + 1))
  [ "$i" -gt 7500 ] && { rm -f "$REQ"; exit 1; }
done

# 响应文件内容：明文 KV username=...\npassword=... 或 cancel=1。
if grep -q '^cancel=1' "$RESP" 2>/dev/null; then
  rm -f "$REQ" "$RESP"
  exit 1   # 用户取消：退出非零让 git 报认证失败（与无凭据行为一致）。
fi

cat "$RESP"   # 明文 KV 直接喂回 git（git 自己处理百分号解码与否）。
rm -f "$REQ" "$RESP"
