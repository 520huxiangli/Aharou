<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Android 13+ 相册读：细粒度媒体权限优先，用户不开「所有文件访问」也能查相册。 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 前台服务类型对应权限：targetSdk 34 起，声明了 foregroundServiceType 却没申请对应权限，
         startForeground() 直接抛 SecurityException。两个前台服务统一用 specialUse（用例见各自 service）。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 语音通话：麦克风类型前台服务。Android 14+ 要求 startForeground 时 RECORD_AUDIO 已授予，
         且该类型只能从可见界面启动——通话因此必须由用户点按发起，不能后台自启。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Update（灵动岛 / 流体云）：声明后方能请求系统把够格的常驻通知提升为胶囊。
         非运行时权限，系统未支持或不满足资格时静默退化为普通通知。 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 自动化任务的「每天 8:00」这类精确时刻。Android 12+ 属特殊权限，用户可在系统里收走，
         故调度层同时保留 WorkManager 周期兜底，未授权时降级为不精确闹钟。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- [Aharou] 权限拉满：Agent 全能力所需 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 通话音频模式（MODE_IN_COMMUNICATION）与输出设备控制 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <!-- Android 11+ 的包可见性：Shizuku 不在默认可见范围内，声明后才能查它的安装状态与启动入口。
         另有 QUERY_ALL_PACKAGES 兜底，这里显式声明以缩小对全量包可见性的依赖。
         Shevery 是换了包名的 Shizuku 分支，不声明会被当成未安装。
         换其它包名的 fork 靠 ShizukuManager 按权限名运行时枚举，不需要（也不能）在 queries 里
         声明 permission 元素——该元素不合法，包可见性由上面的 QUERY_ALL_PACKAGES 保证。 -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.hamondev.shevery" />
    </queries>

    <application
        android:name=".AIEditorApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AICode"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:localeConfig="@xml/locales_config">

        <!-- configChanges 自行接管旋转与窗口尺寸变化：Compose 会跟着新 Configuration 重组，
             不重建 Activity 才能保住终端 TerminalView、编辑器未保存内容与聊天列表位置。
             故意不含 locale —— 语言切换仍走 MainActivity 里的 recreate 路径。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden"
            android:launchMode="singleTop"
            android:theme="@style/Theme.AICode.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 接收其它应用分享的文件，直接进当前会话的输入框附件。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- 划词菜单：在任意 App 选中文字后，菜单里出现「Aharou」，点了把这段文字送进聊天输入框。
                 只接管 text/plain；同一个 Activity 加 filter，不新建 Activity。 -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- 桌面快捷方式（长按图标）走隐式 intent：applicationId 随 flavor 变化
                 （com.aharou.agent / .debug / .beta），而 res/xml 不支持 applicationId 占位符替换
                 （Intent.parseIntent 只有 targetPackage 与 targetClass 同时存在才会设显式组件），
                 故用自定义 action 在此声明匹配，shortcuts.xml 里不写 targetPackage。 -->
            <intent-filter>
                <action android:name="com.aharou.intent.NEW_CHAT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.aharou.intent.START_VOICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- 「打开方式」入口：在文件管理器 / QQ 等选「用 Aharou 打开」。只收 content/file
                 两种 scheme——不加限定的话，浏览器点 http 链接也会把 Aharou 列进候选。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- 长按桌面图标弹出的静态快捷方式（新建对话 / 开始语音通话）。 -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 未捕获异常时由 AIEditorApp 的全局 handler 拉起，全屏展示崩溃详情供复制反馈。独立进程运行，避免被主进程崩溃影响或引发 Application 业务逻辑重跑。 -->
        <activity
            android:name=".CrashActivity"
            android:process=":crash"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.AICode" />

        <!-- 移除 WorkManager 的默认初始化器：它在 ContentProvider 阶段（早于 Application.onCreate
             与 Hilt 字段注入）就用「默认配置」初始化 WorkManager，于是 @HiltWorker 的 Worker
             拿不到 HiltWorkerFactory，构造时报 NoSuchMethodException 而永远跑不起来。
             移除后改由 WorkManager 首次被取用时按 Configuration.Provider 延迟初始化。 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <provider
            android:name=".feature.workspace.data.provider.WorkspaceDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 终端保活：常驻前台通知，让后台会话不被系统回收。
             用 specialUse 而不是 dataSync：Android 15(35) 起 dataSync 前台服务在 24 小时内累计只能跑 6 小时，
             超时会被系统强杀，保活形同虚设；specialUse 面向「用户可见的自定义用途」，正对本场景。 -->
        <service
            android:name=".feature.terminal.domain.TerminalKeepaliveService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="保持后台终端会话存活，避免容器进程被系统回收" />
        </service>

        <!-- Telegram 机器人接入：前台服务持有 getUpdates 长轮询协程，把 Telegram 消息接进 agent。
             同样用 specialUse（理由见服务类注释），通知栏提供「停止」按钮。 -->
        <service
            android:name=".feature.im.service.TelegramBotService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="持有 Telegram 长轮询连接，让用户能在 Telegram 里与本机 AI agent 对话" />
        </service>

        <!-- 微信 iLink（ClawBot）：同样长轮询、同样 specialUse，理由同上。 -->
        <service
            android:name=".feature.im.service.WeixinBotService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="持有微信 iLink 长轮询连接，让用户能在微信里与本机 AI agent 对话" />
        </service>

        <!-- 飞书：WebSocket 长连接，同样 specialUse。 -->
        <service
            android:name=".feature.im.service.FeishuBotService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="持有飞书 WebSocket 长连接，让用户能在飞书里与本机 AI agent 对话" />
        </service>

        <!-- QQ 开放平台：WebSocket Gateway，同样 specialUse。 -->
        <service
            android:name=".feature.im.service.QqBotService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="持有 QQ 机器人 WebSocket 连接，让用户能在 QQ 里与本机 AI agent 对话" />
        </service>

        <!-- 跨设备协作：局域网内的 MCP Streamable HTTP 服务，把本机能力（读/写文件、受限 shell、截图）
             暴露给已配对的设备调用；默认关闭，需用户在设置里手动开启，通知栏可一键停止。
             同样用 specialUse（理由见服务类注释）——它既不是数据同步也不是媒体播放，属用户可见的自定义用途。 -->
        <service
            android:name=".feature.remotedevice.service.RemoteDeviceService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="在局域网内持有跨设备协作服务，让已配对设备请求本机执行动作（需本机用户逐次审批）" />
        </service>

        <!-- 无障碍服务：让 Agent「看得懂、点得动」宿主屏幕（读节点树/手势/截图）。
             需用户在系统「无障碍」设置中手动开启（Android 禁止程序化开启）。 -->
        <service
            android:name="com.aharou.accessibility.AharouAccessibilityService"
            android:exported="true"
            android:label="@string/a11y_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/aharou_accessibility_service" />
        </service>

        <!-- 通知读取：让 Agent 能回答「刚才谁给我发消息了」。这个权限只能由用户在系统
             「通知使用权」里手动勾选，应用无法自行申请，也不该假装能申请。 -->
        <service
            android:name="com.aharou.feature.agent.domain.tool.device.DeviceNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 小染悬浮层：用户开着就一直在的桌面伙伴，同时承担原来的「状态胶囊」职责
             （Agent 进度、通话字幕、通话开关都在她身上）。需悬浮窗权限。 -->
        <service
            android:name="com.aharou.feature.pet.PetOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="用户主动开启的桌面伙伴悬浮窗，并显示 Agent 进度与通话字幕" />
        </service>

        <!-- 语音通话：悬浮窗 + 实时语音回合。用 microphone 类型，通话期间必须持有麦克风。 -->
        <service
            android:name="com.aharou.feature.voice.call.VoiceCallService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- 数字助手（可选）：用户把它选为默认助手后，系统会一直保活这个服务，
             唤醒比普通前台服务稳，也能接长按 / 锁屏唤起。代价是系统同时只允许一个
             默认助手，开了就会顶掉原有的（如小布）。 -->
        <service
            android:name="com.aharou.feature.voice.assistant.AharouVoiceInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <!-- exported 必须为 true：系统（system uid）要去绑定它才能派发会话，
             实际访问控制由 BIND_VOICE_INTERACTION（signature|privileged）兜住，第三方拿不到该权限。 -->
        <service
            android:name="com.aharou.feature.voice.assistant.AharouVoiceSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- 重启/升级后把电源键监听拉回来（getevent 进程随重启消失）。 -->
        <receiver
            android:name="com.aharou.feature.voice.assistant.PowerKeyBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 长按电源键唤起：靠 Shizuku 跑 getevent 监听电源键（普通应用读不到 /dev/input）。 -->
        <service
            android:name="com.aharou.feature.voice.assistant.PowerKeyWatcherService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="通过 Shizuku 监视电源键长按，用于在任意应用里唤起助手浮层" />
        </service>

        <!-- 下拉快捷磁贴：ColorOS 把长按电源独占给自家小布，三方应用只能靠磁贴自己留一个常驻入口。 -->
        <service
            android:name="com.aharou.feature.voice.assistant.AssistantTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/assistant_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 助手浮层：由上面的会话经 startAssistantActivity 拉起，窗口由系统按助手规则摆好。
             只由本应用启动，不进最近任务。 -->
        <activity
            android:name="com.aharou.feature.voice.assistant.presentation.AssistantOverlayActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.aharou.assistant.overlay"
            android:theme="@style/Theme.AICode.Assistant"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:windowSoftInputMode="adjustResize" />

        <!-- 官方要求数字助手必须同时提供识别服务（见 AOSP 语音交互简介）；
             实际识别走自有引擎，这里只做合法占位。 -->
        <service
            android:name="com.aharou.feature.voice.assistant.AharouRecognitionService"
            android:exported="true"
            android:permission="android.permission.BIND_RECOGNITION_SERVICE">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- 开机与应用被更新后把悬浮窗服务拉回来。START_STICKY 只覆盖「被系统查杀」，
             包替换（pm install）与设备重启都不会自动拉起服务，用户会以为开关失效了。
             接收器自己会先查设置里的开关，关着就不启动。 -->
        <receiver
            android:name="com.aharou.feature.pet.PetRestartReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 桌面小组件：快捷入口 + 最近会话。 -->
        <receiver
            android:name="com.aharou.feature.widget.AharouAppWidget"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/aharou_widget_info" />
        </receiver>

        <!-- 自动化任务的精确闹钟到点唤醒；只由本 App 的 PendingIntent 触发，不对外暴露。 -->
        <receiver
            android:name="com.aharou.feature.agent.domain.schedule.ScheduledTaskAlarmReceiver"
            android:exported="false" />

        <!-- 自动化任务的事件源：只做两件事——开机与应用被更新时触发 boot 类任务、恢复周期检查，
             代码里也只认这两个 action（别的 action 一律忽略，防伪造广播拿它当触发入口）。
             带 intent-filter 的接收器必须显式声明 exported，这里给 false：系统广播照收，
             外部应用发的同名广播拦在外面。 -->
        <receiver
            android:name="com.aharou.feature.agent.domain.schedule.trigger.AutomationEventReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 工具授权通知的动作接收器：通知栏「允许/拒绝/直接回复」经它回填到 App 内的授权入口。
             无 intent-filter，exported=false，只接收本 App 通过显式 PendingIntent 发来的广播。 -->
        <receiver
            android:name="com.aharou.feature.agent.presentation.notification.AgentPermissionActionReceiver"
            android:exported="false" />

        <!-- Shizuku：用于以 adb shell 身份执行命令（UserService）。
             permission 声明为 INTERACT_ACROSS_USERS_FULL 是官方要求，防止普通应用访问该 provider。 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
